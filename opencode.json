{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "npm run build*": "allow",
      "npm run test*": "allow",
      "npm test*": "allow",
      "npx tsc*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    }
  }
}