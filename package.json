{
  "name": "taridev-software-factory",
  "version": "2.0.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:web\"",
    "server": "tsx watch server/index.ts",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.mjs",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0", "@types/node": "^22.13.0"
  },
  "devDependencies": {}
}
